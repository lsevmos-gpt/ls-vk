PORT=3000
NODE_ENV=production

# Internal protection for this gateway. Use a long random value.
INTERNAL_API_KEY=change-me

# VK API
VK_API_VERSION=5.199
VK_GROUP_ID=
VK_GROUP_TOKEN=

# Recommended for photo/video uploads if community auth is rejected by VK.
# Never commit the real value.
VK_USER_TOKEN=
