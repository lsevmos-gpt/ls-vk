PORT=3000
NODE_ENV=production

# Internal protection for this gateway. Use a long random value.
INTERNAL_API_KEY=change-me

# VK API
VK_API_VERSION=5.199
VK_GROUP_ID=

# Required for publishing wall posts, photos and videos.
# Must belong to an administrator of the target community.
# Never commit the real value.
VK_USER_TOKEN=

# Optional. May be useful for community-specific API methods,
# but it is NOT the primary publishing credential.
VK_GROUP_TOKEN=
