PORT=3000
NODE_ENV=production

# Internal protection for this gateway. Use a long random value.
INTERNAL_API_KEY=change-me

# VK ID app. Kept for future auth experiments; not required for basic community posting.
VK_APP_ID=54806879
VK_REDIRECT_URI=https://vk.liniyasporta.ru/oauth/callback

# VK API
VK_API_VERSION=5.199
VK_GROUP_ID=
VK_GROUP_SCREEN_NAME=liniya__sporta

# Primary credential for publishing to the community wall.
# Create it in Community management -> API -> Access keys.
# Never commit the real value.
VK_GROUP_TOKEN=

# Optional advanced credential.
# New VK ID vk2.a.* tokens are NOT suitable for wall/photo/video API publishing.
# A compatible legacy/API user token may be needed for photo/video upload.
VK_USER_TOKEN=
